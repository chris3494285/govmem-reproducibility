  "sanitize_rules": [
    {
      "name": "public_repo_root",
      "pattern": "<PUBLIC_REPO_ROOT>",
      "replacement": "<PUBLIC_REPO_ROOT>"
    },
    {
      "name": "private_repo_root",
      "pattern": "<PRIVATE_REPO_ROOT>",
      "replacement": "<PRIVATE_REPO_ROOT>"
    },
    {
      "name": "longmemeval_source",
      "pattern": "$LONGMEMEVAL_SOURCE/longmemeval-cleaned/longmemeval_oracle.json",
      "replacement": "$LONGMEMEVAL_SOURCE/longmemeval-cleaned/longmemeval_oracle.json"
    },
    {
      "name": "memora_source",
      "pattern": "$MEMORA_SOURCE",
      "replacement": "$MEMORA_SOURCE"
    },
    {
      "name": "oaks_novel_source",
      "pattern": "$OAKS_NOVEL_SOURCE",
      "replacement": "$OAKS_NOVEL_SOURCE"
    },
    {
      "name": "user_home",
      "pattern": "$USER_HOME",
      "replacement": "$USER_HOME"
    },
    {
      "name": "formal_block_fingerprint",
      "pattern": "<FORMAL_BLOCK_FINGERPRINT>",
      "replacement": "<FORMAL_BLOCK_FINGERPRINT>"
    },
    {
      "name": "formal_block_fingerprint_abbrev",
      "pattern": "<FORMAL_BLOCK_FINGERPRINT>",
      "replacement": "<FORMAL_BLOCK_FINGERPRINT>"
    }
  ],
  "redact_json_fields": {
    "drop_json_fields": [
      "frozen_block_fingerprint"
    ]
  },
  "forbidden_patterns": [
    {
      "name": "absolute_user_path",
      "regex": "/Users/[A-Za-z]|/home/[A-Za-z]",
      "extensions": [".py", ".json", ".jsonl", ".csv", ".md", ".txt", ".tex", ".toml", ".cfg", ".ini", ".yaml", ".yml", ".sh"]
    },
    {
      "name": "openai_secret",
      "regex": "sk-[A-Za-z0-9]{20,}",
      "extensions": ["*"]
    },
    {
      "name": "google_secret",
      "regex": "AIza[0-9A-Za-z_-]{30,}",
      "extensions": ["*"]
    },
    {
      "name": "github_secret",
      "regex": "ghp_[A-Za-z0-9]{20,}",
      "extensions": ["*"]
    },
    {
      "name": "aws_secret",
      "regex": "AKIA[0-9A-Z]{16}",
      "extensions": ["*"]
    },
    {
      "name": "private_key_block",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "extensions": ["*"]
    },
    {
      "name": "benchmark_text_field",
      "regex": "\"(task_question|task_oracle_answer|task_options|oracle_answer|expected_answer|model_answer|native_abstention_answers|model_visible_context_text|prompt_text|context_text|response_text|parsed_answer|normalized_model_answer|normalized_oracle_answer|source_evidence|memories)\"\\s*:",
      "extensions": [".json", ".jsonl", ".csv"]
    },
    {
      "name": "benchmark_plain_text_field",
      "regex": "\"(question|answer)\"\\s*:",
      "extensions": [".json", ".jsonl", ".csv"]
    },
    {
      "name": "request_identifier_field",
      "regex": "\"request_id\"\\s*:",
      "extensions": [".json", ".jsonl", ".csv"]
    },
    {
      "name": "source_derived_identifier",
      "regex": "(longmemeval::[0-9a-f]{6,}|memora::(?:weekly|monthly|quarterly|yearly|daily)::|memora::judge::[0-9a-f]{16}|oaks_novel::P[0-9]|memconflict::[0-9a-f]{8}-|gatemem::)",
      "extensions": [".json", ".jsonl", ".csv", ".md", ".txt", ".tex", ".py"]
    },
    {
      "name": "block_or_slot_fingerprint",
      "regex": "(pilot-block|formal-300-slot|clean-repeat-judge)::[0-9a-f]{16,}",
      "extensions": [".json", ".jsonl", ".csv", ".md", ".txt", ".tex", ".py"]
    },
    {
      "name": "content_fingerprint_field",
      "regex": "\"(model_visible_context_sha256|prompt_sha256|source_fingerprint|content_sha256|answer_sha256|generation_prompt_sha256|semantic_prompt_hash|native_message_locators|response_sha256|new_context_sha256|old_context_sha256|new_prompt_sha256|old_prompt_sha256|frozen_block_fingerprint)\"\\s*:",
      "extensions": [".json", ".jsonl", ".csv"]
    },
    {
      "name": "row_identity_key",
      "regex": "\"(base_id|condition_id|pair_id)\"\\s*:",
      "extensions": [".json", ".jsonl", ".csv"]
    },
    {
      "name": "email_address",
      "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "extensions": ["*"]
    }
  ],
  "audit_exemptions": [
    {
      "path": "release/aggregate_only_release_allowlist.json",
      "rules": [
        "source_derived_identifier"
      ],
      "reason": "The match is the allowlist's own regular-expression definition for forbidden dataset-prefixed identifiers, not a source-derived identifier value."
    },
    {
      "path": "tests/fixtures/memora-mini/**",
      "rules": ["benchmark_text_field", "benchmark_plain_text_field"],
      "reason": "Author-created synthetic three-session fixture that only mimics the Memora question/answer schema ('The weekly report is due Friday.'). It contains no benchmark-derived content, no real Memora persona, and no real identifiers, so the benchmark-text key rules do not apply. Reviewed manually on 2026-10-14."
    },
    {
      "path": "scripts/audit_paper_evidence_counts.py",
      "rules": ["source_derived_identifier"],
      "reason": "PRODUCTION CONSTANT (documented dependency, fail-closed). M3_BASE_ID names the single Memora base used for the M3 intervention example in the paper evidence audit. The audit only reads the base from the frozen base manifest by that exact key and now raises an explicit error when the key is absent, so the frozen experiment semantics cannot silently change. It cannot be replaced with a synthetic value without changing which frozen example is audited. Flagged as an irreducible residual in FINAL_GITHUB_RELEASE_AUDIT.md."
    },
    {
      "path": "scripts/authorize_and_resume_final_b4_holdout.py",
      "rules": ["source_derived_identifier"],
      "reason": "PRODUCTION CONSTANT (documented dependency, fail-closed). TARGET_STARTED_ONLY is the one frozen B4 holdout judge request id classified as started-only eligible; verify_recovery_targets() aborts if that exact row is not the started-only target, so frozen recovery semantics cannot silently change. A synthetic value would break the frozen recovery authorization. Flagged as an irreducible residual in FINAL_GITHUB_RELEASE_AUDIT.md."
    },
    {
      "path": "scripts/run_formal_300_validation.py",
      "rules": ["block_or_slot_fingerprint"],
      "reason": "PRODUCTION CONSTANTS (documented dependency, fail-closed). Three formal-300 slot fingerprints are frozen recovery-protocol targets (anthropic attempt-3, openai no-text, attempt-4 smoke). The associated authorization validators compare against the frozen recovery manifests/ledgers and raise on any drift, so frozen experiment semantics cannot silently change. Synthetic values would not match the frozen artifacts. Flagged as irreducible residuals in FINAL_GITHUB_RELEASE_AUDIT.md."
    }
  ],
  "notes": {
    "excluded_by_construction": [
      "Every file not matched by an `include` pattern: results/final_main_tier_b/**, all",
      "data/*.jsonl benchmark manifests and oracle dumps, text-bearing v3 manifests,",
      "provider rerun manifests, cohort/judge-request files, the manuscript directory",
      "paper_aiopen_final/ and the paper zip, historical/exploratory result",
      "directories, .git/, caches, logs, and .env."
    ],
    "row_level_exclusions": [
      "The row-level Tier-B score files (results/final_main_tier_b/*.jsonl) are NOT",
      "shipped. This release is aggregate-only: it contains no per-example benchmark",
      "record, no per-example benchmark identifier, and no per-example content",
      "fingerprint.",
      "",
      "Genuinely aggregate artifacts that are retained: overall / by-source /",
      "by-event / by-fault / by-provider summary tables and JSON summaries,",
      "protocol + readiness documentation, and the clean-repeat block-level table,",
      "whose row keys are release-synthetic labels",
      "(clean-repeat-v1::<provider>::<source>::NN) that do not identify any",
      "benchmark example and whose mapping to examples is not shipped."
    ],
    "sanitize_scope": [
      "sanitize_rules are applied only to UTF-8-decodable text files and only",
      "rewrite machine-specific absolute paths. No numeric statistic, hash, row",
      "count, or frozen manifest is altered by the builder."
    ],
    "identifier_pseudonymization": [
      "Not used for this release: no retained file contains a source-derived",
      "identifier, so no original->pseudonym mapping is needed and none is shipped."
    ],
    "inclusion_review_2026_10_15": [
      "Added by the 2026-10-15 synchronization pass. Every addition was reviewed",
      "individually and each is aggregate-only:",
      "",
      "B4_FINAL_EVIDENCE_GAP_AUDIT.md - aggregate evidence-gap audit of the frozen",
      "Formal-300 and B4 scorer-validation artifacts. Contains cohort/coverage",
      "counts, agreement rates, and artifact SHA-256 prefixes only; no benchmark",
      "text, no per-example record, no per-example identifier.",
      "",
      "results/source_event_fault_distribution_v1/* - the six aggregate outputs",
      "(three count CSVs, one summary JSON, one report, one LaTeX table) of",
      "scripts/analyze_source_event_fault_distribution.py. Cell counts are",
      "source x event x fault aggregates; the only identifier-shaped string is the",
      "schema note 'pair_id == base_id::fault_operator', which is a field-format",
      "description, not a value.",
      "",
      "results/formal_300_subgroup_v1/* - the six aggregate outputs (three summary",
      "CSVs, one bootstrap-comparison JSON, one report, one LaTeX table) of",
      "scripts/analyze_formal_300_subgroups.py. Contains dataset/provider/cell",
      "effect estimates and bootstrap intervals only. The analysis script reads the",
      "private block-level Formal-300 file locally and deliberately emits no",
      "block, base, or observation identifier; the two excluded blocks are",
      "described by stratum only.",
      "",
      "Deliberately NOT included: results/b4_scoring_validation/private/** (raw",
      "judge payloads, ledgers, adjudication payloads), any *.jsonl cohort,",
      "judge-request, execution-plan, or observation file, and the private",
      "block-level Formal-300 CSV that the subgroup script consumes locally.",
      "",
      "results/paper_evidence_audit/{event_macro_reconciliation,condition_trace_validation}.{json,md}",
      "- the four aggregate outputs of scripts/audit_event_macro_reconciliation.py",
      "(B2) and scripts/validate_condition_traces.py (M3). They contain effect",
      "estimates, per-event/per-provider tables, pass counts, and rates only. The",
      "trace validator compares benchmark text in memory and emits counts, never",
      "text, hashes, locators, or condition identifiers; its field tallies are",
      "rendered as lists so no manifest field name becomes a JSON object key.",
      "The other files in that directory (b3_count_reconciliation.*,",
      "m3_intervention_example.*, current_paper_count_crosscheck.md) are row-level",
      "developer artifacts and remain excluded."
    ]
  }
}
